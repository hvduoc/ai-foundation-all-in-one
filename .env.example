# -------- App --------
PORT=3000
LOG_LEVEL=info

# -------- Cache / Redis --------
# DÙNG REDIS THẬT (prod/staging/dev):
# - BỎ comment REDIS_URL và đặt token/host thật (Upstash hoặc Redis khác).
# - Đặt REDIS_MOCK=false (hoặc xóa dòng này).
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<HOST>:6379
REDIS_MOCK=false

# DÙNG MOCK (test/local):
# - Đặt REDIS_MOCK=true và CẨN THẬN: khi dùng mock thì KHÔNG cần REDIS_URL.
# - Ở CI unit-tests, workflow đã set REDIS_MOCK=true nên không đọc file này.
# REDIS_MOCK=true

# -------- Cache options --------
KEY_PREFIX=aifao1:dev:
USER_CACHE_TTL=300
CACHE_ENABLED=1

# -------- Ghi chú --------
# - Tuyệt đối không commit secret thật.
# - Với CI unit-tests: KHÔNG set REDIS_URL (workflow đã ép REDIS_MOCK=true).
# - Với môi trường chạy thật: luôn cung cấp REDIS_URL qua GitHub Secrets/Environments.
